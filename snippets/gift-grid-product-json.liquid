{% liquid
  assign featured_img = product.featured_media.preview_image | default: product.featured_image
  assign img_url = ''
  if featured_img
    assign img_url = featured_img | image_url: width: 800
  endif
%}
{
  "id": {{ product.id | json }},
  "title": {{ product.title | escape | json }},
  "description": {{ product.description | strip_html | truncatewords: 30 | json }},
  "price": {{ product.price | money | json }},
  "image": {{ img_url | json }},
  "options": [
    {% for option in product.options_with_values %}
      {
        "name": {{ option.name | json }},
        "values": {{ option.values | json }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  "variants": [
    {% for variant in product.variants %}
      {% liquid
        assign var_img = variant.featured_media.preview_image | default: variant.featured_image
        assign var_img_url = ''
        if var_img
          assign var_img_url = var_img | image_url: width: 800
        else
          assign var_img_url = img_url
        endif
      %}
      {
        "id": {{ variant.id | json }},
        "price": {{ variant.price | money | json }},
        "available": {{ variant.available | json }},
        "image": {{ var_img_url | json }},
        "options": {{ variant.options | json }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}

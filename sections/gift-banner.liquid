{% liquid
  assign hero_image = section.settings.hero_image
  assign fallback_url = 'Frame.svg' | asset_url
%}

<section class="gift-banner gift-banner-{{ section.id }}" id="gift-banner-{{ section.id }}">

  <!-- HEADER -->
  <header class="gift-banner__header">
    <div class="gift-banner__logo">
      <a href="{{ section.settings.logo_url | default: routes.root_url }}">
        {{ section.settings.logo_text | default: 'TISSO VISON' | escape }}
      </a>
    </div>

    <div class="gift-banner__announcement">
      {{ section.settings.announcement_text | default: 'Find the ideal gift for your loved ones.' | escape }}
    </div>

    <button type="button" class="gift-banner__choose" id="choose-gift-{{ section.id }}">
      <span>{{ section.settings.choose_gift_text | default: 'CHOOSE GIFT' | escape }}</span>
      <span aria-hidden="true">&rarr;</span>
    </button>
  </header>


  <!-- HERO -->
  <div class="gift-banner__hero">

    <!-- FIRST COPY: sits at the top of the hero, establishes the upper row of objects -->
    {% if hero_image %}
      <img
        class="gift-banner__frame gift-banner__frame--top"
        src="{{ hero_image | image_url: width: 2400 }}"
        srcset="
          {{ hero_image | image_url: width: 800 }} 800w,
          {{ hero_image | image_url: width: 1200 }} 1200w,
          {{ hero_image | image_url: width: 1800 }} 1800w,
          {{ hero_image | image_url: width: 2400 }} 2400w
        "
        sizes="100vw"
        alt=""
        aria-hidden="true"
        loading="eager"
      >
    {% else %}
      <img class="gift-banner__frame gift-banner__frame--top" src="{{ fallback_url }}" alt="" aria-hidden="true" loading="eager">
    {% endif %}

    <!-- SECOND COPY: shifted down; the white content panel masks its left side,
         the objects on the right of the panel stay visible -->
    {% if hero_image %}
      <img
        class="gift-banner__frame gift-banner__frame--bottom"
        src="{{ hero_image | image_url: width: 2400 }}"
        srcset="
          {{ hero_image | image_url: width: 800 }} 800w,
          {{ hero_image | image_url: width: 1200 }} 1200w,
          {{ hero_image | image_url: width: 1800 }} 1800w,
          {{ hero_image | image_url: width: 2400 }} 2400w
        "
        sizes="100vw"
        alt=""
        aria-hidden="true"
        loading="eager"
      >
    {% else %}
      <img class="gift-banner__frame gift-banner__frame--bottom" src="{{ fallback_url }}" alt="" aria-hidden="true" loading="eager">
    {% endif %}

    <!-- WHITE CONTENT PANEL: intentionally opaque, masks the second copy on the LEFT only -->
    <div class="gift-banner__content">

      <h1>{{ section.settings.heading | default: 'The Gift Guide' | escape }}</h1>

      <div class="gift-banner__description">
        <p class="gift-banner__main-text">
          {{ section.settings.subheading_1 | default: 'Discover Joy: Your Ultimate Holiday Gift Destination.' | escape }}
        </p>
        <p class="gift-banner__secondary-text">
          {{ section.settings.subheading_2 | default: 'Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.' | escape }}
        </p>
      </div>

      <a href="{{ section.settings.button_link | default: '#gift-grid-section' }}" class="gift-banner__shop" id="shop-now-{{ section.id }}">
        <span>{{ section.settings.button_label | default: 'SHOP NOW' | escape }}</span>
        <span aria-hidden="true">&rarr;</span>
      </a>

    </div>

  </div>


  <!-- BOTTOM STRIP -->
  <div class="gift-banner__bottom">
    {{ section.settings.strip_text | default: 'SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL' | escape }}
  </div>

</section>


<style>
  .gift-banner-{{ section.id }} {
    width: 100%;
    margin: 0;
    padding: 0;
    background: #fff;
    color: #111;
    font-family: 'Jost', sans-serif;
  }

  .gift-banner-{{ section.id }} *,
  .gift-banner-{{ section.id }} *::before,
  .gift-banner-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  /* ================= HEADER ================= */

  .gift-banner-{{ section.id }} .gift-banner__header {
    height: 70px;
    width: 100%;
    padding: 0 55px;
    background: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .gift-banner-{{ section.id }} .gift-banner__logo a {
    color: #111;
    text-decoration: none;
    font-size: 23px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 2.8px;
  }

  .gift-banner-{{ section.id }} .gift-banner__announcement {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: 'Jost', sans-serif;
    font-size: 16px;
    line-height: 1;
    font-weight: 400;
    color: #000000;
  }

  .gift-banner-{{ section.id }} .gift-banner__choose {
    position: relative;
    margin-left: auto;
    width: 227px;
    height: 48px;
    border: 0;
    border-radius: 0;
    background: #fff033;
    color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    font-family: 'Jost', sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: .4px;
    cursor: pointer;
    overflow: hidden;
    z-index: 1;
    transition: color .4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .gift-banner-{{ section.id }} .gift-banner__choose::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #000;
    z-index: -1;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform .4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .gift-banner-{{ section.id }} .gift-banner__choose:hover::before {
    transform: scaleX(1);
  }

  .gift-banner-{{ section.id }} .gift-banner__choose:hover {
    color: #fff;
  }

  .gift-banner-{{ section.id }} .gift-banner__choose span {
    position: relative;
    z-index: 2;
    color: inherit;
    transition: color .4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .gift-banner-{{ section.id }} .gift-banner__choose span:last-child {
    font-size: 23px;
    font-weight: 400;
    transition: transform .25s ease, color .4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .gift-banner-{{ section.id }} .gift-banner__choose:hover span:last-child {
    transform: translateX(5px);
    color: #fff;
  }

  /* ================= HERO ================= */

  .gift-banner-{{ section.id }} .gift-banner__hero {
    position: relative;
    width: 100%;
    height: clamp(700px, 49.6vw, 855px);
    overflow: hidden;
    background: #fff;
  }

  /* FRAME #1 — top copy, scaled by width only so aspect ratio holds */
  .gift-banner-{{ section.id }} .gift-banner__frame {
    position: absolute;
    left: 0;
    width: 100%;
    height: auto;
    max-width: none;
    display: block;
    pointer-events: none;
    user-select: none;
  }

  .gift-banner-{{ section.id }} .gift-banner__frame--top {
    top: clamp(-180px, -11.5vw, -110px);
    z-index: 1;
  }

  /* FRAME #2 — begins roughly mid-hero; stays visible on the RIGHT,
     gets covered on the LEFT by the white content panel */
  .gift-banner-{{ section.id }} .gift-banner__frame--bottom {
    top: clamp(360px, 25.8vw, 445px);
    left: 8%;
    z-index: 2;
  }

  /* CONTENT PANEL — opaque white, masks frame #2 on the left,
     fixed width lets frame #2 stay visible to its right */
  .gift-banner-{{ section.id }} .gift-banner__content {
    position: absolute;
    left: 0;
    top: clamp(360px, 25.8vw, 445px);
    width: clamp(560px, 37.1vw, 640px);
    height: clamp(360px, 23.8vw, 410px);
    padding-left: clamp(45px, 4.18vw, 72px);
    padding-top: clamp(45px, 3.48vw, 60px);
    padding-right: 35px;
    background: #fff;
    z-index: 5;
  }

  .gift-banner-{{ section.id }} .gift-banner__content h1 {
    margin: 0 0 clamp(24px, 2.8vw, 42px);
    padding: 0;
    color: #111;
    font-family: 'Jost', sans-serif;
    font-size: clamp(52px, 4.4vw, 74px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -2px;
  }

  .gift-banner-{{ section.id }} .gift-banner__description {
    width: min(480px, 100%);
  }

  .gift-banner-{{ section.id }} .gift-banner__description p {
    margin: 0;
  }

  .gift-banner-{{ section.id }} .gift-banner__main-text {
    margin-bottom: 8px !important;
    color: #111;
    font-size: clamp(15px, 1.1vw, 18px);
    line-height: 1.4;
    font-weight: 400;
  }

  .gift-banner-{{ section.id }} .gift-banner__secondary-text {
    color: #111;
    font-size: clamp(15px, 1.1vw, 18px);
    line-height: 1.45;
    font-weight: 400;
  }

  /* ================= SHOP NOW ================= */

  .gift-banner-{{ section.id }} .gift-banner__shop {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    width: 220px;
    height: 52px;
    margin-top: clamp(24px, 3vw, 45px);
    background: #000;
    color: #fff;
    text-decoration: none;
    font-size: 14px;
    line-height: 1;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    overflow: hidden;
    z-index: 1;
    transition: color .4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .gift-banner-{{ section.id }} .gift-banner__shop::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #fff033;
    z-index: -1;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform .4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .gift-banner-{{ section.id }} .gift-banner__shop:hover::before {
    transform: scaleX(1);
  }

  .gift-banner-{{ section.id }} .gift-banner__shop:hover {
    color: #000;
  }

  .gift-banner-{{ section.id }} .gift-banner__shop span {
    position: relative;
    z-index: 2;
    color: inherit;
    transition: color .4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .gift-banner-{{ section.id }} .gift-banner__shop span:last-child {
    font-size: 22px;
    transition: transform .25s ease, color .4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .gift-banner-{{ section.id }} .gift-banner__shop:hover span:last-child {
    transform: translateX(5px);
    color: #000;
  }

  /* ================= BOTTOM STRIP ================= */

  .gift-banner-{{ section.id }} .gift-banner__bottom {
    width: 100%;
    height: 36px;
    background: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #222;
    font-size: 12px;
    line-height: 1;
    font-weight: 600;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    text-align: center;
    padding: 0 12px;
  }

  /* ================= TABLET ================= */

  @media screen and (max-width: 1000px) {

    .gift-banner-{{ section.id }} .gift-banner__header {
      padding: 0 30px;
    }

    .gift-banner-{{ section.id }} .gift-banner__announcement {
      display: none;
    }

    .gift-banner-{{ section.id }} .gift-banner__hero {
      height: clamp(680px, 78vw, 780px);
    }

    .gift-banner-{{ section.id }} .gift-banner__frame {
      width: 100%;
    }

    .gift-banner-{{ section.id }} .gift-banner__frame--top {
      top: clamp(-90px, -2vw, -65px);
    }

    .gift-banner-{{ section.id }} .gift-banner__frame--bottom {
      top: clamp(360px, 40vw, 400px);
      left: 8%;
    }

    .gift-banner-{{ section.id }} .gift-banner__content {
      top: clamp(360px, 40vw, 400px);
      width: 58%;
      max-width: 640px;
      height: clamp(340px, 38vw, 380px);
      padding-left: clamp(35px, 4.5vw, 45px);
      padding-top: clamp(38px, 4.5vw, 45px);
    }

    .gift-banner-{{ section.id }} .gift-banner__content h1 {
      font-size: 62px;
      margin-bottom: 38px;
    }

    .gift-banner-{{ section.id }} .gift-banner__description {
      width: 100%;
    }

    .gift-banner-{{ section.id }} .gift-banner__main-text,
    .gift-banner-{{ section.id }} .gift-banner__secondary-text {
      font-size: 17px;
    }
  }

  /* ================= MOBILE ================= */

  @media screen and (max-width: 600px) {

    .gift-banner-{{ section.id }} .gift-banner__header {
      height: auto;
      min-height: 70px;
      padding: 14px 18px;
      gap: 12px;
      flex-wrap: wrap;
    }

    .gift-banner-{{ section.id }} .gift-banner__logo a {
      font-size: 18px;
      letter-spacing: 2px;
    }

    .gift-banner-{{ section.id }} .gift-banner__choose {
      width: clamp(125px, 38vw, 145px);
      height: 42px;
      font-size: 11px;
      gap: 9px;
    }

    .gift-banner-{{ section.id }} .gift-banner__hero {
      height: 760px;
    }

    .gift-banner-{{ section.id }} .gift-banner__frame--top {
      width: 135%;
      left: -17.5%;
      top: clamp(-110px, -22vw, -75px);
    }

    .gift-banner-{{ section.id }} .gift-banner__frame--bottom {
      top: clamp(360px, 82vw, 420px);
      width: 135%;
      left: -7.5%;
    }

    .gift-banner-{{ section.id }} .gift-banner__content {
      left: 0;
      top: clamp(360px, 82vw, 420px);
      width: 82%;
      height: 340px;
      padding-left: clamp(20px, 5.5vw, 32px);
      padding-top: clamp(28px, 7vw, 35px);
      padding-right: 15px;
    }

    .gift-banner-{{ section.id }} .gift-banner__content h1 {
      font-size: 48px;
      letter-spacing: -2px;
      margin-bottom: 30px;
    }

    .gift-banner-{{ section.id }} .gift-banner__description {
      width: 100%;
    }

    .gift-banner-{{ section.id }} .gift-banner__main-text {
      font-size: 16px;
    }

    .gift-banner-{{ section.id }} .gift-banner__secondary-text {
      font-size: 15px;
    }

    .gift-banner-{{ section.id }} .gift-banner__shop {
      width: 210px;
      height: 50px;
      margin-top: 30px;
      font-size: 12px;
    }

    .gift-banner-{{ section.id }} .gift-banner__bottom {
      height: auto;
      min-height: 34px;
      padding: 10px;
      font-size: 8px;
      letter-spacing: 1.1px;
    }
  }
</style>


<script>
  (function () {
    'use strict';

    function initGiftBanner() {
      var chooseButton = document.getElementById('choose-gift-{{ section.id }}');
      var shopButton = document.getElementById('shop-now-{{ section.id }}');

      function scrollToGiftGrid(event) {
        if (event) {
          event.preventDefault();
        }
        var grid = document.getElementById('gift-grid-section');
        if (grid) {
          grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      if (chooseButton && !chooseButton.dataset.initialized) {
        chooseButton.dataset.initialized = 'true';
        chooseButton.addEventListener('click', scrollToGiftGrid);
      }

      if (shopButton && !shopButton.dataset.initialized) {
        shopButton.dataset.initialized = 'true';
        shopButton.addEventListener('click', function (event) {
          var href = shopButton.getAttribute('href');
          if (!href || href === '#' || href === '#gift-grid-section') {
            scrollToGiftGrid(event);
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGiftBanner);
    } else {
      initGiftBanner();
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        initGiftBanner();
      }
    });
  })();
</script>


{% schema %}
{
  "name": "Gift Banner",
  "tag": "section",
  "class": "section-gift-banner",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo", "default": "TISSO VISON" },
    { "type": "url", "id": "logo_url", "label": "Logo Link" },
    { "type": "text", "id": "announcement_text", "label": "Announcement", "default": "Find the ideal gift for your loved ones." },
    { "type": "text", "id": "choose_gift_text", "label": "Choose Gift", "default": "CHOOSE GIFT" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero illustration" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Gift Guide" },
    { "type": "textarea", "id": "subheading_1", "label": "Subtitle", "default": "Discover Joy: Your Ultimate Holiday Gift Destination." },
    { "type": "textarea", "id": "subheading_2", "label": "Description", "default": "Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season." },
    { "type": "text", "id": "button_label", "label": "Shop Button", "default": "SHOP NOW" },
    { "type": "url", "id": "button_link", "label": "Shop Button Link" },
    { "type": "text", "id": "strip_text", "label": "Bottom Strip", "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL" }
  ],
  "presets": [
    { "name": "Gift Banner" }
  ]
}
{% endschema %}

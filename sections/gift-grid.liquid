  .gift-grid-{{ section.id }} .gift-grid__add-to-cart {
    width: 100%;
    height: 48px;
    margin-top: 18px;
    border: 0;
    background: #000;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: .5px;
    text-transform: uppercase;
    cursor: pointer;
    transition: background .15s ease;
  }

  .gift-grid-{{ section.id }} .gift-grid__add-to-cart span:last-child {
    font-size: 18px;
  }

  .gift-grid-{{ section.id }} .gift-grid__add-to-cart:disabled {
    background: #888;
    cursor: not-allowed;
    opacity: 0.7;
  }

  .gift-grid-{{ section.id }} .gift-grid__add-to-cart:not(:disabled):hover {
    background: #222;
  }

  /* ================= MOBILE RESPONSIVE ================= */
  @media screen and (max-width: 749px) {

    /* Grid layout: 2 columns with smaller gap */
    .gift-grid-{{ section.id }} .gift-grid__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: {{ section.settings.gap_mobile }}px;
    }

    /* Reduce inner padding on mobile */
    .gift-grid-{{ section.id }} .gift-grid__inner {
      padding-left: 12px;
      padding-right: 12px;
      padding-top: 16px;
      padding-bottom: 16px;
    }

    /* Heading smaller on mobile */
    .gift-grid-{{ section.id }} .gift-grid__heading {
      font-size: 20px;
      margin-bottom: 14px;
    }

    /* Hotspot button slightly smaller on mobile */
    .gift-grid-{{ section.id }} .gift-grid__hotspot {

  .gift-grid-{{ section.id }} .gift-grid__select-trigger[aria-expanded="true"] .gift-grid__select-chevron {
    transform: rotate(180deg);
  }

  .gift-grid-{{ section.id }} .gift-grid__select-dropdown {
    position: absolute;
    top: 100%;
    left: 0;

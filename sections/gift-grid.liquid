{% liquid
  assign fallback_collection = section.settings.collection | default: collections.all
  assign fallback_products = fallback_collection.products

  assign soft_jacket_product = all_products['soft-winter-jacket']
  assign soft_jacket_variant_id = ''
  if soft_jacket_product != blank
    assign soft_jacket_variant_id = soft_jacket_product.first_available_variant.id | default: soft_jacket_product.variants[0].id
  else
    for p in collections.all.products
      assign p_title_lower = p.title | downcase
      if p_title_lower contains 'soft winter jacket' or p_title_lower contains 'winter jacket'
        assign soft_jacket_variant_id = p.first_available_variant.id | default: p.variants[0].id
        break
      endif
    endfor
  endif
%}

<section class="gift-grid gift-grid-{{ section.id }}" id="gift-grid-section" data-soft-winter-jacket-id="{{ soft_jacket_variant_id }}">

  <div class="gift-grid__inner">

    <h2 class="gift-grid__heading">
      {{ section.settings.heading | default: 'Tisso vison in the wild' }}
    </h2>

    <div class="gift-grid__grid">

      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}

          {% liquid
            assign tile_product = block.settings.product
            if tile_product == blank
              assign tile_product = fallback_products[forloop.index0]
            endif

            assign tile_product_2 = block.settings.product_2
            if tile_product_2 == blank
              assign tile_product_2 = tile_product
            endif

            assign tile_image = block.settings.image
            if tile_image == blank and tile_product != blank
              assign tile_image = tile_product.featured_media.preview_image | default: tile_product.featured_image
            endif
          %}

          <div class="gift-grid__tile" {{ block.shopify_attributes }}>

            {% if tile_image %}
              <img
                class="gift-grid__image"
                src="{{ tile_image | image_url: width: 900 }}"
                srcset="
                  {{ tile_image | image_url: width: 450 }} 450w,
                  {{ tile_image | image_url: width: 700 }} 700w,
                  {{ tile_image | image_url: width: 900 }} 900w,
                  {{ tile_image | image_url: width: 1200 }} 1200w
                "
                sizes="(max-width: 749px) 50vw, 33vw"
                alt="{{ tile_image.alt | default: tile_product.title | escape }}"
                loading="lazy"
                width="{{ tile_image.width | default: 800 }}"
                height="{{ tile_image.height | default: 1000 }}"
              >
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'gift-grid__image gift-grid__image--placeholder' }}
            {% endif %}

            {% if tile_product %}
              <button
                type="button"
                class="gift-grid__hotspot"
                style="left: {{ block.settings.hotspot_x | default: 70 }}%; top: {{ block.settings.hotspot_y | default: 35 }}%;"
                data-hotspot
                data-product-id="{{ tile_product.id }}"
                aria-label="{{ 'products.product.quick_view' | default: 'Quick view' }} {{ tile_product.title | escape }}"
              >
                <span aria-hidden="true">+</span>
              </button>

              <script type="application/json" data-product-data="{{ tile_product.id }}">
                {% render 'gift-grid-product-json', product: tile_product %}
              </script>
            {% endif %}

            {% if block.settings.enable_second_hotspot and tile_product_2 %}
              <button
                type="button"
                class="gift-grid__hotspot"
                style="left: {{ block.settings.hotspot_2_x | default: 30 }}%; top: {{ block.settings.hotspot_2_y | default: 60 }}%;"
                data-hotspot
                data-product-id="{{ tile_product_2.id }}"
                aria-label="{{ 'products.product.quick_view' | default: 'Quick view' }} {{ tile_product_2.title | escape }}"
              >
                <span aria-hidden="true">+</span>
              </button>

              {% unless tile_product_2.id == tile_product.id %}
                <script type="application/json" data-product-data="{{ tile_product_2.id }}">
                  {% render 'gift-grid-product-json', product: tile_product_2 %}
                </script>
              {% endunless %}
            {% endif %}

            <div class="gift-grid__added-badge" aria-label="Added to cart" title="Added to cart">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
            </div>

          </div>

        {% endfor %}

      {% else %}

        {% for product in fallback_products limit: 6 %}
          {% liquid
            assign tile_image = product.featured_media.preview_image | default: product.featured_image
          %}
          <div class="gift-grid__tile">

            {% if tile_image %}
              <img
                class="gift-grid__image"
                src="{{ tile_image | image_url: width: 900 }}"
                srcset="
                  {{ tile_image | image_url: width: 450 }} 450w,
                  {{ tile_image | image_url: width: 700 }} 700w,
                  {{ tile_image | image_url: width: 900 }} 900w,
                  {{ tile_image | image_url: width: 1200 }} 1200w
                "
                sizes="(max-width: 749px) 50vw, 33vw"
                alt="{{ tile_image.alt | default: product.title | escape }}"
                loading="lazy"
                width="{{ tile_image.width | default: 800 }}"
                height="{{ tile_image.height | default: 1000 }}"
              >
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'gift-grid__image gift-grid__image--placeholder' }}
            {% endif %}

            <button
              type="button"
              class="gift-grid__hotspot"
              style="left: 65%; top: 35%;"
              data-hotspot
              data-product-id="{{ product.id }}"
              aria-label="{{ 'products.product.quick_view' | default: 'Quick view' }} {{ product.title | escape }}"
            >
              <span aria-hidden="true">+</span>
            </button>

            <script type="application/json" data-product-data="{{ product.id }}">
              {% render 'gift-grid-product-json', product: product %}
            </script>

            <div class="gift-grid__added-badge" aria-label="Added to cart" title="Added to cart">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
            </div>

          </div>
        {% endfor %}

      {% endif %}

    </div>

  </div>


  <!-- QUICK VIEW MODAL -->
  <div class="gift-grid__modal" data-modal hidden>
    <div class="gift-grid__modal-backdrop" data-modal-close></div>

    <div class="gift-grid__modal-panel" role="dialog" aria-modal="true">

      <button type="button" class="gift-grid__modal-close" data-modal-close aria-label="Close">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 1L15 15M15 1L1 15" stroke="currentColor" stroke-width="1.6"/>
        </svg>
      </button>

      <div class="gift-grid__modal-top">
        <img class="gift-grid__modal-image" data-modal-image src="" alt="">
        <div class="gift-grid__modal-info">
          <p class="gift-grid__modal-title" data-modal-title></p>
          <p class="gift-grid__modal-price" data-modal-price></p>
          <p class="gift-grid__modal-description" data-modal-description></p>
        </div>
      </div>

      <div class="gift-grid__modal-option gift-grid__modal-option--swatch" data-option-1-wrap hidden>
        <p class="gift-grid__modal-option-label" data-option-1-label>Color</p>
        <div class="gift-grid__swatches" data-option-1-values></div>
      </div>

      <div class="gift-grid__modal-option" data-option-2-wrap hidden>
        <p class="gift-grid__modal-option-label" data-option-2-label>Size</p>
        <div class="gift-grid__custom-select" data-custom-select>
          <button type="button" class="gift-grid__select-trigger" data-select-trigger aria-expanded="false">
            <span data-select-value>Choose your size</span>
            <div class="gift-grid__select-chevron-box">
              <svg class="gift-grid__select-chevron" data-select-chevron width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="1.4"/>
              </svg>
            </div>
          </button>
          <div class="gift-grid__select-dropdown" data-select-dropdown hidden></div>
        </div>
      </div>

      <button type="button" class="gift-grid__add-to-cart" data-add-to-cart disabled>
        <span data-add-to-cart-label>ADD TO CART</span>
        <span aria-hidden="true">&rarr;</span>
      </button>

    </div>
  </div>

  <button
    type="button"
    class="gift-grid__floating-cart"
    data-floating-cart-trigger
    aria-label="Open cart"
    title="Open cart"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="9" cy="21" r="1"></circle>
      <circle cx="20" cy="21" r="1"></circle>
      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
    </svg>
    <span class="gift-grid__floating-cart-count" data-floating-cart-count>{{ cart.item_count | default: 0 }}</span>
  </button>

  <!-- CART MODAL -->
  <div class="gift-grid__cart-modal" data-cart-modal hidden>
    <div class="gift-grid__cart-modal-backdrop" data-cart-modal-close></div>
    <div class="gift-grid__cart-modal-panel">
      <div class="gift-grid__cart-modal-header">
        <h3 class="gift-grid__cart-modal-title">Your Cart</h3>
        <button type="button" class="gift-grid__cart-modal-close" data-cart-modal-close aria-label="Close cart">&times;</button>
      </div>
      <div class="gift-grid__cart-modal-body" data-cart-modal-body>
        <p class="gift-grid__cart-empty">Your cart is empty.</p>
      </div>
      <div class="gift-grid__cart-modal-footer" data-cart-modal-footer hidden>
        <div class="gift-grid__cart-modal-total">
          <span>Total</span>
          <span data-cart-modal-total>$0.00</span>
        </div>
        <a href="/checkout" class="gift-grid__cart-modal-checkout">CHECKOUT</a>
      </div>
    </div>
  </div>

</section>


<style>
  .gift-grid-{{ section.id }} {
    width: 100%;
    background: #fff;
    color: #111;
    font-family: 'Jost', sans-serif;
  }

  .gift-grid-{{ section.id }} *,
  .gift-grid-{{ section.id }} *::before,
  .gift-grid-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  .gift-grid-{{ section.id }} .gift-grid__inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top | default: 24 }}px {{ section.settings.padding_inline | default: 20 }}px {{ section.settings.padding_bottom | default: 24 }}px;
  }

  .gift-grid-{{ section.id }} .gift-grid__heading {
    margin: 0 0 20px;
    font-weight: 400;
    font-size: clamp(22px, 2vw, 28px);
    letter-spacing: -.3px;
  }

  .gift-grid-{{ section.id }} .gift-grid__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.gap }}px;
  }

  .gift-grid-{{ section.id }} .gift-grid__tile {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.image_aspect_ratio | default: '1 / 1' }};
    overflow: hidden;
    background: #f4f4f4;
  }

  .gift-grid-{{ section.id }} .gift-grid__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gift-grid-{{ section.id }} .gift-grid__image--placeholder {
    opacity: .5;
  }

  .gift-grid-{{ section.id }} .gift-grid__hotspot {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, .92);
    color: #111;
    font-size: 18px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 1px 4px rgba(0, 0, 0, .18);
    transition: transform .15s ease, background .15s ease;
  }

  .gift-grid-{{ section.id }} .gift-grid__hotspot:hover {
    background: #fff;
    transform: translate(-50%, -50%) scale(1.08);
  }

  /* FLOATING CART BUTTON (BOTTOM RIGHT OF SCREEN) */
  .gift-grid-{{ section.id }} .gift-grid__floating-cart {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 99999;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #000;
    color: #fff;
    border: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25);
  }

  .gift-grid-{{ section.id }} .gift-grid__floating-cart:hover {
    background: #111;
  }

  .gift-grid-{{ section.id }} .gift-grid__floating-cart-count {
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 11px;
    background: #1652f0;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #fff;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }

  /* Added Card State: Dimmed Image */
  .gift-grid-{{ section.id }} .gift-grid__tile.is-added .gift-grid__image {
    opacity: 0.65;
    filter: brightness(0.92);
    transition: opacity 0.3s ease, filter 0.3s ease;
  }

  /* ================= CART MODAL ================= */
  .gift-grid__cart-modal {
    position: fixed;
    inset: 0;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gift-grid__cart-modal[hidden] {
    display: none !important;
  }

  .gift-grid__cart-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }

  .gift-grid__cart-modal-panel {
    position: relative;
    width: 90%;
    max-width: 480px;
    max-height: 80vh;
    background: #fff;
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
  }

  .gift-grid__cart-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 20px;
    border-bottom: 1px solid #e5e5e5;
  }

  .gift-grid__cart-modal-title {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    color: #000;
  }

  .gift-grid__cart-modal-close {
    background: none;
    border: 0;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    color: #333;
    padding: 0 4px;
  }

  .gift-grid__cart-modal-body {
    flex: 1;
    overflow-y: auto;
    padding: 0;
  }

  .gift-grid__cart-empty {
    text-align: center;
    padding: 40px 20px;
    color: #888;
    font-size: 15px;
  }

  .gift-grid__cart-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 20px;
    border-bottom: 1px solid #f0f0f0;
  }

  .gift-grid__cart-item-img {
    width: 60px;
    height: 60px;
    object-fit: cover;
    flex-shrink: 0;
    background: #f4f4f4;
  }

  .gift-grid__cart-item-info {
    flex: 1;
    min-width: 0;
  }

  .gift-grid__cart-item-title {
    font-size: 14px;
    font-weight: 500;
    color: #000;
    margin: 0 0 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .gift-grid__cart-item-variant {
    font-size: 12px;
    color: #888;
    margin: 0 0 4px;
  }

  .gift-grid__cart-item-price {
    font-size: 14px;
    font-weight: 600;
    color: #000;
  }

  .gift-grid__cart-item-qty {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
  }

  .gift-grid__cart-item-qty button {
    width: 24px;
    height: 24px;
    border: 1px solid #ccc;
    background: #fff;
    cursor: pointer;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
  }

  .gift-grid__cart-item-qty span {
    font-size: 13px;
    min-width: 16px;
    text-align: center;
  }

  .gift-grid__cart-item-remove {
    background: none;
    border: 0;
    cursor: pointer;
    font-size: 18px;
    color: #999;
    padding: 4px;
    flex-shrink: 0;
  }

  .gift-grid__cart-item-remove:hover {
    color: #000;
  }

  .gift-grid__cart-modal-footer {
    padding: 16px 20px;
    border-top: 1px solid #e5e5e5;
  }

  .gift-grid__cart-modal-total {
    display: flex;
    justify-content: space-between;
    font-size: 16px;
    font-weight: 600;
    color: #000;
    margin-bottom: 14px;
  }

  .gift-grid__cart-modal-checkout {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 48px;
    background: #000;
    color: #fff;
    border: 0;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-decoration: none;
    cursor: pointer;
  }

  .gift-grid__cart-modal-checkout:hover {
    background: #222;
  }

  /* ================= MODAL ================= */

  .gift-grid-{{ section.id }} .gift-grid__modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .gift-grid-{{ section.id }} .gift-grid__modal[hidden] {
    display: none;
  }

  .gift-grid-{{ section.id }} .gift-grid__modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(17, 17, 17, .45);
  }

  .gift-grid-{{ section.id }} .gift-grid__modal-panel {
    position: relative;
    width: 100%;
    max-width: 375px;
    max-height: calc(100vh - 40px);
    overflow-y: visible;
    background: #fff;
    padding: 28px 24px 24px;
    z-index: 1;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }

  .gift-grid-{{ section.id }} .gift-grid__modal-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 24px;
    height: 24px;
    border: 0;
    background: transparent;
    color: #111;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .gift-grid-{{ section.id }} .gift-grid__modal-top {
    display: flex;
    gap: 14px;
    margin-bottom: 18px;
    align-items: flex-start;
  }

  .gift-grid-{{ section.id }} .gift-grid__modal-image {
    width: 120px;
    height: 140px;
    object-fit: cover;
    background: #f4f4f4;
    flex-shrink: 0;
  }

  .gift-grid-{{ section.id }} .gift-grid__modal-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .gift-grid-{{ section.id }} .gift-grid__modal-title {
    margin: 0 0 6px;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.25;
    color: #111;
  }

  .gift-grid-{{ section.id }} .gift-grid__modal-price {
    margin: 0 0 8px;
    font-size: 15px;
    font-weight: 400;
    color: #111;
  }

  .gift-grid-{{ section.id }} .gift-grid__modal-description {
    margin: 0;
    font-size: 12px;
    line-height: 1.45;
    color: #555;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .gift-grid-{{ section.id }} .gift-grid__modal-option {
    margin-bottom: 14px;
    position: relative;
  }

  .gift-grid-{{ section.id }} .gift-grid__modal-option-label {
    margin: 0 0 6px;
    font-size: 13px;
    color: #333;
  }

  /* COLOR SWATCHES */
  .gift-grid-{{ section.id }} .gift-grid__swatches {
    display: flex;
    border: 1px solid #000;
    width: 100%;
  }

  .gift-grid-{{ section.id }} .gift-grid__swatch {
    flex: 1;
    height: 42px;
    padding: 0 10px;
    border: 0;
    border-right: 1px solid #000;
    background: #fff;
    color: #000;
    font-size: 14px;
    font-weight: 400;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .gift-grid-{{ section.id }} .gift-grid__swatch:last-child {
    border-right: 0;
  }

  /* Color swatch hover: NO black background */
  .gift-grid-{{ section.id }} .gift-grid__swatch:hover {
    background: #fff;
    color: #000;
  }

  /* Color swatch SELECTED: background black with white text */
  .gift-grid-{{ section.id }} .gift-grid__swatch[aria-pressed="true"] {
    background: #000 !important;
    color: #fff !important;
    font-weight: 500;
  }

  .gift-grid-{{ section.id }} .gift-grid__swatch[aria-pressed="true"]::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: #1652f0;
  }

  /* CUSTOM SIZE DROPDOWN */
  .gift-grid-{{ section.id }} .gift-grid__custom-select {
    position: relative;
    width: 100%;
  }

  .gift-grid-{{ section.id }} .gift-grid__select-trigger {
    width: 100%;
    height: 44px;
    border: 1px solid #000;
    background: #fff;
    color: #111;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0 0 14px;
    font-size: 14px;
    cursor: pointer;
    text-align: left;
  }

  .gift-grid-{{ section.id }} .gift-grid__select-trigger span {
    font-size: 14px;
    color: #111;
  }

  .gift-grid-{{ section.id }} .gift-grid__select-chevron-box {
    width: 44px;
    height: 44px;
    border-left: 1px solid #000;
    display: flex;
    align-items: center;

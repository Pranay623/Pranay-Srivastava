    }

    .gift-grid-{{ section.id }} .gift-grid__floating-cart-count {
      width: 18px;
      height: 18px;
      font-size: 10px;
      top: -4px;
      right: -4px;
    }

    /* ---- Product Quick-View Modal (mobile) ---- */
    .gift-grid-{{ section.id }} .gift-grid__modal {
      padding: 12px;
      align-items: flex-end;

  .gift-grid-{{ section.id }} .gift-grid__dropdown-item:last-child {
    border-bottom: 0;
  }

  .gift-grid-{{ section.id }} .gift-grid__dropdown-item:hover {
    background: #000 !important;
    color: #fff !important;
  }

  .gift-grid-{{ section.id }} .gift-grid__dropdown-item.is-selected {
    background: #fff;

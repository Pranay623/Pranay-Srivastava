    .gift-grid-{{ section.id }} .gift-grid__modal-panel {
      max-width: 100%;
      max-height: 85vh;
      padding: 20px 16px 16px;
      overflow-y: auto;
    }

    .gift-grid-{{ section.id }} .gift-grid__modal-top {

      max-height: 85vh;
    }

    .gift-grid__cart-modal-header {
      padding: 14px 16px;
    }

    .gift-grid__cart-modal-title {
      font-size: 16px;
    }

    .gift-grid__cart-item {
      gap: 10px;
      padding: 10px 16px;
    }

    .gift-grid__cart-item-img {
      width: 50px;
      height: 50px;
    }

    .gift-grid__cart-item-title {
      font-size: 13px;
    }

    .gift-grid__cart-item-price {
      font-size: 13px;
    }

    .gift-grid__cart-modal-footer {
      padding: 12px 16px;
    }

    .gift-grid__cart-modal-checkout {
      height: 44px;
      font-size: 13px;
    }
  }

  /* ================= SMALL PHONES ================= */
  @media screen and (max-width: 374px) {

    .gift-grid-{{ section.id }} .gift-grid__inner {
      padding-left: 8px;
      padding-right: 8px;
    }

    .gift-grid-{{ section.id }} .gift-grid__heading {
      font-size: 18px;
      margin-bottom: 10px;
    }

    .gift-grid-{{ section.id }} .gift-grid__hotspot {
      width: 22px;
      height: 22px;
      font-size: 12px;
    }

    .gift-grid-{{ section.id }} .gift-grid__modal-panel {
      padding: 16px 12px 12px;
    }

    .gift-grid-{{ section.id }} .gift-grid__modal-image {
      width: 70px;
      height: 90px;
    }

    .gift-grid-{{ section.id }} .gift-grid__modal-title {
      font-size: 14px;
    }

    .gift-grid__cart-modal-panel {
      width: 100%;
    }
  }
</style>


<script>
  (function () {
    'use strict';

    var root = document.getElementById('gift-grid-section');
    if (!root || root.dataset.giftGridInitialized) return;
    root.dataset.giftGridInitialized = 'true';

    var modal = root.querySelector('[data-modal]');
    var modalImage = root.querySelector('[data-modal-image]');
    var modalTitle = root.querySelector('[data-modal-title]');
    var modalPrice = root.querySelector('[data-modal-price]');
    var modalDescription = root.querySelector('[data-modal-description]');

    var option1Wrap = root.querySelector('[data-option-1-wrap]');
    var option1Label = root.querySelector('[data-option-1-label]');
    var option1Values = root.querySelector('[data-option-1-values]');

    var option2Wrap = root.querySelector('[data-option-2-wrap]');
    var option2Label = root.querySelector('[data-option-2-label]');
    var selectTrigger = root.querySelector('[data-select-trigger]');
    var selectValueText = root.querySelector('[data-select-value]');
    var selectDropdown = root.querySelector('[data-select-dropdown]');

    var addButton = root.querySelector('[data-add-to-cart]');
    var addButtonLabel = root.querySelector('[data-add-to-cart-label]');

    var currentProduct = null;
    var selectedOptions = [];
    var defaultAddLabel = 'ADD TO CART';
    var lastFocusedHotspot = null;

    function getProductData(productId, triggerEl) {
      var script = null;
      if (productId) {
        script = root.querySelector('script[data-product-data="' + productId + '"]') || document.querySelector('script[data-product-data="' + productId + '"]');
      }
      if (!script && triggerEl) {
        var tile = triggerEl.closest('.gift-grid__tile');
        script = tile ? tile.querySelector('script[data-product-data]') : null;
      }
      if (script) {
        try {
          var data = JSON.parse(script.textContent);
          if (data && data.title) return data;
        } catch (err) {}
      }

      var defaultTitle = 'Orange Wide Leg';
      if (triggerEl) {
        var ariaLabel = triggerEl.getAttribute('aria-label') || '';
        if (ariaLabel) {
          defaultTitle = ariaLabel.replace(/^Quick view\s*/i, '').trim() || defaultTitle;
        }
      }

      return {
        id: productId || 'demo-1',
        title: defaultTitle,
        price: '980,00€',
        description: 'This one-piece swimsuit is crafted from jersey featuring an allover micro Monogram motif in relief.',
        image: 'https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-lifestyle-1_800x.png',
        options: [
          { name: 'Color', values: ['White', 'Black'] },
          { name: 'Size', values: ['XS', 'S', 'M', 'L', 'XL'] }
        ],
        variants: [
          { id: 'v1', price: '980,00€', available: true, options: ['White', 'S'] },
          { id: 'v2', price: '980,00€', available: true, options: ['Black', 'S'] }
        ]
      };
    }

    function findMatchingVariant() {
      if (!currentProduct || !currentProduct.variants) return null;
      var match = currentProduct.variants.filter(function (variant) {
        return variant.options.every(function (value, index) {
          return selectedOptions[index] === undefined || selectedOptions[index] === value;
        });
      });
      return match[0] || null;
    }

    function updatePriceAndButton() {
      var variant = findMatchingVariant();

      if (variant) {
        if (variant.price) modalPrice.textContent = variant.price;
        if (variant.image) modalImage.src = variant.image;
      }

      if (!variant) {
        if (currentProduct && currentProduct.variants && currentProduct.variants[0]) {
          addButton.disabled = false;
          addButtonLabel.textContent = defaultAddLabel;
          addButton.dataset.variantId = currentProduct.variants[0].id;
        } else {
          addButton.disabled = true;
          addButtonLabel.textContent = 'Select options';
        }
      } else if (!variant.available) {
        addButton.disabled = true;
        addButtonLabel.textContent = 'Sold out';
        addButton.dataset.variantId = variant.id;
      } else {
        addButton.disabled = false;
        addButtonLabel.textContent = defaultAddLabel;
        addButton.dataset.variantId = variant.id;
      }
    }

    function buildOptionUI(product) {
      option1Wrap.hidden = true;
      option2Wrap.hidden = true;
      option1Values.innerHTML = '';
      selectDropdown.innerHTML = '';
      selectDropdown.hidden = true;
      if (selectTrigger) selectTrigger.setAttribute('aria-expanded', 'false');

      var allOptions = product.options || [];

      // Find color option index in product.options
      var colorOptIndex = -1;
      var colorOpt = null;
      for (var i = 0; i < allOptions.length; i++) {
        if (allOptions[i] && allOptions[i].name && allOptions[i].name.toLowerCase().indexOf('color') !== -1) {
          colorOptIndex = i;
          colorOpt = allOptions[i];
          break;
        }
      }
      if (!colorOpt) {
        colorOptIndex = 0;
        colorOpt = { name: 'Color', values: ['White', 'Black'] };
      }

      // Find size option index in product.options
      var sizeOptIndex = -1;
      var sizeOpt = null;
      for (var j = 0; j < allOptions.length; j++) {
        if (allOptions[j] && allOptions[j].name && allOptions[j].name.toLowerCase().indexOf('size') !== -1) {
          sizeOptIndex = j;
          sizeOpt = allOptions[j];
          break;
        }
      }
      if (!sizeOpt) {
        sizeOptIndex = colorOptIndex === 0 ? 1 : 0;
        sizeOpt = { name: 'Size', values: ['XS', 'S', 'M', 'L', 'XL'] };
      }

      selectedOptions = [];
      var firstVariant = (product.variants || []).filter(function (v) { return v.available; })[0] || (product.variants || [])[0];
      if (firstVariant && firstVariant.options && firstVariant.options.length) {
        selectedOptions = firstVariant.options.slice();
      }

      // 1. COLOR SWATCHES (Option 1)
      option1Label.textContent = 'Color';
      if (!selectedOptions[colorOptIndex] && colorOpt.values.length) {
        selectedOptions[colorOptIndex] = colorOpt.values[0];
      }

      colorOpt.values.forEach(function (value) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'gift-grid__swatch';
        btn.textContent = value;
        btn.dataset.colorValue = value.toLowerCase();
        btn.setAttribute('aria-pressed', selectedOptions[colorOptIndex] === value ? 'true' : 'false');
        btn.addEventListener('click', function () {
          option1Values.querySelectorAll('.gift-grid__swatch').forEach(function (b) {
            b.setAttribute('aria-pressed', 'false');
          });
          btn.setAttribute('aria-pressed', 'true');
          selectedOptions[colorOptIndex] = value;
          updatePriceAndButton();
        });
        option1Values.appendChild(btn);
      });
      option1Wrap.hidden = false;

      // 2. SIZE CUSTOM DROPDOWN (Option 2)
      option2Label.textContent = 'Size';
      var currentSelectedVal = selectedOptions[sizeOptIndex] || '';
      selectValueText.textContent = currentSelectedVal || 'Choose your size';

      sizeOpt.values.forEach(function (value) {
        var itemBtn = document.createElement('button');
        itemBtn.type = 'button';
        itemBtn.className = 'gift-grid__dropdown-item';
        if (currentSelectedVal === value) {
          itemBtn.classList.add('is-selected');
        }
        itemBtn.textContent = value;

        itemBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          selectDropdown.querySelectorAll('.gift-grid__dropdown-item').forEach(function (b) {
            b.classList.remove('is-selected');
          });
          itemBtn.classList.add('is-selected');
          selectedOptions[sizeOptIndex] = value;
          selectValueText.textContent = value;
          selectDropdown.hidden = true;
          if (selectTrigger) selectTrigger.setAttribute('aria-expanded', 'false');
          updatePriceAndButton();
        });

        selectDropdown.appendChild(itemBtn);
      });

      selectTrigger.onclick = function (e) {
        e.stopPropagation();
        var isOpen = !selectDropdown.hidden;
        selectDropdown.hidden = isOpen;
        selectTrigger.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      };

      option2Wrap.hidden = false;
    }

    function openModal(productId, triggerEl) {
      var product = getProductData(productId, triggerEl);
      if (!product) return;

      currentProduct = product;
      lastFocusedHotspot = triggerEl || null;

      if (product.image) modalImage.src = product.image;
      modalImage.alt = product.title || '';
      modalTitle.textContent = product.title || '';
      modalDescription.textContent = product.description || '';

      buildOptionUI(product);
      updatePriceAndButton();

      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      var closeBtn = modal.querySelector('.gift-grid__modal-close');
      if (closeBtn) closeBtn.focus();
    }

    function closeModal() {
      modal.hidden = true;
      document.body.style.overflow = '';
      if (selectDropdown) selectDropdown.hidden = true;
      if (selectTrigger) selectTrigger.setAttribute('aria-expanded', 'false');
      currentProduct = null;
      if (lastFocusedHotspot) lastFocusedHotspot.focus();
    }

    root.addEventListener('click', function (event) {
      var hotspot = event.target.closest('[data-hotspot]');
      if (hotspot) {
        event.preventDefault();
        event.stopPropagation();
        openModal(hotspot.dataset.productId, hotspot);
        return;
      }

      if (event.target.closest('[data-modal-close]')) {
        closeModal();
        return;
      }

      if (selectDropdown && !selectDropdown.hidden && !event.target.closest('[data-custom-select]')) {
        selectDropdown.hidden = true;
        if (selectTrigger) selectTrigger.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && modal && !modal.hidden) {
        closeModal();
      }
    });

    function isBlackAndMediumSelected() {
      if (!selectedOptions || !selectedOptions.length) return false;
      var hasBlack = false;
      var hasMedium = false;

      selectedOptions.forEach(function (optVal) {
        if (!optVal) return;
        var valStr = optVal.toString().toLowerCase().trim();
        if (valStr === 'black') {
          hasBlack = true;
        }
        if (valStr === 'medium' || valStr === 'm') {
          hasMedium = true;
        }
      });

      return hasBlack && hasMedium;
    }

    // Auto-discover Soft Winter Jacket ID if not supplied via Liquid
    (function fetchSoftWinterJacketId() {
      if (root.dataset.softWinterJacketId) return;

      fetch('/products/soft-winter-jacket.js')
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (prod) {
          if (prod && prod.variants && prod.variants[0]) {
            root.dataset.softWinterJacketId = prod.variants[0].id;
            window.softWinterJacketVariantId = prod.variants[0].id;
          }
        })
        .catch(function () {
          fetch('/search/suggest.json?q=Soft+Winter+Jacket&resources[type]=product')
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (res) {
              if (res && res.resources && res.resources.results && res.resources.results.products) {
                var p = res.resources.results.products[0];
                if (p && p.variants && p.variants[0]) {
                  root.dataset.softWinterJacketId = p.variants[0].id;
                  window.softWinterJacketVariantId = p.variants[0].id;
                }
              }
            });
        });
    })();

    if (addButton) {
      addButton.addEventListener('click', function () {
        var variantId = addButton.dataset.variantId;
        if (!variantId || addButton.disabled) return;

        var numericId = Number(variantId);
        if (!numericId) return;

        addButton.disabled = true;
        addButtonLabel.textContent = 'Adding...';

        var itemsToAdd = [{ id: numericId, quantity: 1 }];

        var softJacketId = root.dataset.softWinterJacketId || window.softWinterJacketVariantId;
        if (isBlackAndMediumSelected() && softJacketId && String(softJacketId) !== '' && String(softJacketId) !== String(variantId)) {
          itemsToAdd.push({ id: Number(softJacketId), quantity: 1 });
        }

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: itemsToAdd })
        })
          .then(function (response) {
            if (!response.ok) throw new Error('Add to cart failed');
            return response.json();
          })
          .then(function () {
            addButtonLabel.textContent = 'Added';
            return fetchAndRenderCart();
          })
          .catch(function () {
            addButtonLabel.textContent = 'Something went wrong';
          })
          .finally(function () {
            setTimeout(function () {
              updatePriceAndButton();
            }, 1400);
          });
      });
    }

    var floatingCartBtn = root.querySelector('[data-floating-cart-trigger]');
    var floatingCartCount = root.querySelector('[data-floating-cart-count]');
    var cartModal = root.querySelector('[data-cart-modal]');
    var cartModalBody = root.querySelector('[data-cart-modal-body]');
    var cartModalFooter = root.querySelector('[data-cart-modal-footer]');
    var cartModalTotal = root.querySelector('[data-cart-modal-total]');

    function updateFloatingCartCount(count) {
      if (floatingCartCount) {
        floatingCartCount.textContent = count;
      }
    }

    function formatMoney(cents) {
      return '$' + (cents / 100).toFixed(2);
    }

    function renderCartModal(cart) {
      if (!cartModalBody) return;

      if (!cart || !cart.items || cart.items.length === 0) {
        cartModalBody.innerHTML = '<p class="gift-grid__cart-empty">Your cart is empty.</p>';
        if (cartModalFooter) cartModalFooter.hidden = true;
        return;
      }

      var html = '';
      cart.items.forEach(function (item, index) {
        var imgSrc = item.image ? item.image.replace(/(\.\w+)$/, '_120x$1') : '';
        var variantTitle = item.variant_title || '';
        html += '<div class="gift-grid__cart-item" data-cart-line="' + (index + 1) + '" data-cart-item-key="' + item.key + '">';
        html += imgSrc ? '<img class="gift-grid__cart-item-img" src="' + imgSrc + '" alt="' + (item.title || '') + '">' : '<div class="gift-grid__cart-item-img"></div>';
        html += '<div class="gift-grid__cart-item-info">';
        html += '<p class="gift-grid__cart-item-title">' + (item.title || '') + '</p>';
        if (variantTitle) html += '<p class="gift-grid__cart-item-variant">' + variantTitle + '</p>';
        html += '<span class="gift-grid__cart-item-price">' + formatMoney(item.final_line_price) + '</span>';
        html += '<div class="gift-grid__cart-item-qty">';
        html += '<button type="button" data-qty-action="minus" data-line="' + (index + 1) + '">−</button>';
        html += '<span>' + item.quantity + '</span>';
        html += '<button type="button" data-qty-action="plus" data-line="' + (index + 1) + '">+</button>';
        html += '</div>';
        html += '</div>';
        html += '<button type="button" class="gift-grid__cart-item-remove" data-remove-line="' + (index + 1) + '" title="Remove">&times;</button>';
        html += '</div>';
      });

      cartModalBody.innerHTML = html;
      if (cartModalFooter) {
        cartModalFooter.hidden = false;
        if (cartModalTotal) {
          cartModalTotal.textContent = formatMoney(cart.total_price);
        }
      }
    }

    function fetchAndRenderCart() {
      return fetch('/cart.js')
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (cart) {
          if (cart) {
            updateFloatingCartCount(cart.item_count || 0);
            renderCartModal(cart);
            syncTilesFromCart(cart);
          }
          return cart;
        });
    }

    function syncTilesFromCart(cart) {
      var addedProductIds = (cart.items || []).map(function (item) {
        return item.product_id ? item.product_id.toString() : '';
      });
      var tiles = root.querySelectorAll('.gift-grid__tile');
      tiles.forEach(function (tile) {
        var buttons = tile.querySelectorAll('[data-product-id]');
        var isMatch = false;
        buttons.forEach(function (btn) {
          if (addedProductIds.indexOf(btn.dataset.productId) !== -1) {
            isMatch = true;
          }
        });
        if (isMatch) {
          tile.classList.add('is-added');
        } else {
          tile.classList.remove('is-added');
        }
      });
    }

    function updateCartLine(line, qty) {
      return fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ line: line, quantity: qty })
      })
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          updateFloatingCartCount(cart.item_count || 0);
          renderCartModal(cart);
          syncTilesFromCart(cart);
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: cart }));

          var countEls = document.querySelectorAll('[data-cart-count], .cart-count, #cart-icon-bubble');
          countEls.forEach(function (el) {
            if (el.dataset.cartCount !== undefined || el.classList.contains('cart-count')) {
              el.textContent = cart.item_count;
            }
          });
        });
    }

    function openCartModal() {
      if (!cartModal) return;
      fetchAndRenderCart().then(function () {
        cartModal.hidden = false;
        document.body.style.overflow = 'hidden';
      });
    }

    function closeCartModal() {
      if (!cartModal) return;
      cartModal.hidden = true;
      document.body.style.overflow = '';
    }

    // Floating cart button click -> open cart modal
    if (floatingCartBtn) {
      floatingCartBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        openCartModal();
      });
    }

    // Cart modal event delegation (close, qty, remove)
    if (cartModal) {
      cartModal.addEventListener('click', function (e) {
        if (e.target.closest('[data-cart-modal-close]')) {
          closeCartModal();
          return;
        }

        var minusBtn = e.target.closest('[data-qty-action="minus"]');
        if (minusBtn) {
          var line = parseInt(minusBtn.dataset.line, 10);
          var qtySpan = minusBtn.parentNode.querySelector('span');
          var currentQty = parseInt(qtySpan.textContent, 10);
          updateCartLine(line, Math.max(0, currentQty - 1));
          return;
        }

        var plusBtn = e.target.closest('[data-qty-action="plus"]');
        if (plusBtn) {
          var line2 = parseInt(plusBtn.dataset.line, 10);
          var qtySpan2 = plusBtn.parentNode.querySelector('span');
          var currentQty2 = parseInt(qtySpan2.textContent, 10);
          updateCartLine(line2, currentQty2 + 1);
          return;
        }

        var removeBtn = e.target.closest('[data-remove-line]');
        if (removeBtn) {
          var removeLine = parseInt(removeBtn.dataset.removeLine, 10);
          updateCartLine(removeLine, 0);
          return;
        }
      });
    }

    // ESC to close cart modal
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && cartModal && !cartModal.hidden) {
        closeCartModal();
      }
    });

    // Sync tiles and cart count on page load
    function syncAddedTilesWithCart() {
      fetchAndRenderCart().catch(function () {});
    }

    // Real-time cart state synchronization on cart events
    ['cart:updated', 'cart:change', 'cart:refresh'].forEach(function (evtName) {
      document.addEventListener(evtName, function () {
        setTimeout(syncAddedTilesWithCart, 100);
      });
    });

    syncAddedTilesWithCart();
  })();
</script>


